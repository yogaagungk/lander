# Example environment file for lander. Install as /etc/lander/lander.env (0600).
# Generate the token with: openssl rand -hex 32
LANDER_SECRET_TOKEN=replace-with-32-plus-random-bytes
LANDER_LISTEN_ADDR=127.0.0.1:8080

# Nginx / system paths
LANDER_SITES_AVAILABLE=/etc/nginx/sites-available
LANDER_SITES_ENABLED=/etc/nginx/sites-enabled
LANDER_NGINX_CONF=/etc/nginx/nginx.conf
LANDER_NGINX_BIN=/usr/sbin/nginx
LANDER_SYSTEMCTL_BIN=/usr/bin/systemctl
LANDER_CERTBOT_BIN=/usr/bin/certbot
LANDER_WEB_ROOT_BASE=/var/www
LANDER_LETSENCRYPT_DIR=/etc/letsencrypt/live

# Prefix privileged commands with "sudo -n" (the systemd unit sets true).
LANDER_SUDO=true

# Trust X-Forwarded-For/X-Real-IP from the loopback nginx vhost.
LANDER_TRUSTED_PROXY=false

# Allow proxying to public upstreams (default false: loopback/RFC1918 only).
LANDER_ALLOW_PUBLIC_UPSTREAM=false

# State and logs
LANDER_ENV_DIR=/var/lib/lander/env
LANDER_AUDIT_LOG=/var/log/lander/audit.log
