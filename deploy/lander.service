[Unit]
Description=ORBIT lander daemon (Nginx manager)
Documentation=https://github.com/yogaagungk/lander
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=simple
User=lander
Group=lander
EnvironmentFile=-/etc/lander/lander.env
Environment=LANDER_SUDO=true
ExecStart=/usr/local/bin/lander
Restart=on-failure
RestartSec=3

# Hardening per ADR-002. NoNewPrivileges must stay off because lander calls
# sudo for the exact nginx/systemctl/certbot commands.
NoNewPrivileges=false
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# ProtectSystem=full makes /usr, /boot and /etc read-only; ReadWritePaths opens
# only what lander (and the sudo'd nginx/certbot children, which inherit this
# mount namespace) must write. /etc/letsencrypt is needed by lander-certbot.
ProtectSystem=full
PrivateDevices=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
# Not set on purpose: MemoryDenyWriteExecute (certbot/python), CapabilityBoundingSet
# (sudo needs SETUID/SETGID/AUDIT_WRITE). Revisit ProtectSystem=strict after the
# first real run (needs RW /var/log/letsencrypt /var/lib/letsencrypt /var/log/nginx /run).
# The "-" prefix ignores missing paths instead of failing with 226/NAMESPACE.
ReadWritePaths=-/etc/nginx/sites-available -/etc/nginx/sites-enabled -/var/lib/lander -/var/log/lander -/etc/letsencrypt

[Install]
WantedBy=multi-user.target
